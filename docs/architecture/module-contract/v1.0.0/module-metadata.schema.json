{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govaryn.io/schemas/module-contract/v1.0.0/module-metadata.schema.json",
  "title": "Govaryn Module Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleContractVersion",
    "moduleId",
    "moduleName",
    "moduleVersion",
    "requiredKernelApiVersion",
    "moduleType",
    "entryPoint"
  ],
  "properties": {
    "moduleContractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "moduleName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)(?:-[0-9A-Za-z-]+(?:\\\\.[0-9A-Za-z-]+)*)?(?:\\\\+[0-9A-Za-z-]+(?:\\\\.[0-9A-Za-z-]+)*)?$"
    },
    "requiredKernelApiVersion": {
      "type": "string",
      "minLength": 1
    },
    "moduleType": {
      "type": "string",
      "enum": [
        "core-extension",
        "integration",
        "feature",
        "observability",
        "security"
      ]
    },
    "entryPoint": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "maxLength": 120
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "versionRange"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "versionRange": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "configSchemaRef": {
      "type": "string",
      "minLength": 1
    },
    "healthChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    }
  }
}
